PORT=3000
HOST=127.0.0.1
DATA_DIR=.data
# Use a long random value in any shared deployment. Local development creates one.
SESSION_SECRET=
# Demo roles are freely switchable; no login or password is required.
# Optional. Leave empty for the clearly labeled scripted simulator.
BEDROCK_MODEL_ID=
AWS_REGION=eu-central-1
# AWS credentials use the standard SDK credential chain (profile / role / env).
# Set PUBLIC_ORIGIN to the exact HTTPS origin when hosting the app.
PUBLIC_ORIGIN=
